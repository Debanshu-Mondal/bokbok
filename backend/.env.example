# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=

# Port the server listens on (Render sets this automatically)
PORT=3000

# Origin allowed to make cross-origin requests (Vite dev server by default)
CLIENT_URL=http://localhost:5173

# development | production
NODE_ENV=development
